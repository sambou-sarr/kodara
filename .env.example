# Base de données (SQLite en local ; pour la prod, passe le provider à postgresql dans prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# URL publique du site (utilisée pour canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret long et aléatoire : signe la session admin et les jetons de téléchargement
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Mot de passe admin, haché :  npm run admin:hash -- "ton-mot-de-passe"
ADMIN_PASSWORD_HASH=""

# Sel des statistiques (visiteurs anonymisés). Si vide, SESSION_SECRET est utilisé.
ANALYTICS_SALT=""

# Portail pub avant téléchargement : "true" pour l'activer. Par défaut (vide ou "false") : téléchargement libre.
ADS_GATE_ENABLED="false"

# Durée minimale (secondes) de l'écran pub avant déblocage du téléchargement (3 à 60)
AD_MIN_SECONDS=8

# Bannières passives Google AdSense (pages du site, jamais dans l'écran de téléchargement).
# Vides = aucune bannière. CLIENT = « ca-pub-... », SLOT = identifiant du bloc d'annonces.
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=""
# /ads.txt est généré à partir de CLIENT ; lignes d'une autre régie séparées par « | »
ADS_TXT_EXTRA=""

# Étiquette de la régie de l'écran de téléchargement (voir src/components/GateAd.tsx)
NEXT_PUBLIC_GATE_AD_PROVIDER="house"

# Vérification Google Search Console (balise meta)
GOOGLE_SITE_VERIFICATION=""
